# Copy to .env for local runs. In the cloud these are GitHub Actions *secrets* (Settings → Secrets → Actions).
# Never commit real values.

# Instagram publishing (Instagram API with Instagram Login — professional account)
IG_USER_ID=
IG_ACCESS_TOKEN=            # long-lived token; the refresh job renews it before expiry

# Claude Code in GitHub Actions (research → editorial → scripts). From `claude setup-token` on your machine.
CLAUDE_CODE_OAUTH_TOKEN=

# Voice: ElevenLabs is used while credits last; otherwise free local Kokoro.
ELEVENLABS_API_KEY=

# Stock media (free keys): https://www.pexels.com/api/  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Alerts (optional): a Telegram bot token + your chat id, or leave empty to rely on GitHub's failure e-mails.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hard spending cap for paid generation, in USD per calendar month. 0 = never call a paid generator.
MONTHLY_PAID_LIMIT_USD=0
